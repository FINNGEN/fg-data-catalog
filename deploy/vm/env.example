# NOTE(Claude Opus 5.5 2026-11-18): the production environment of the catalog,
# installed as /etc/fgdc/env (root only, mode 600) by setup.sh, which fills in
# SECRET_KEY_BASE. Read by systemd (fgdc.service) and by fgdc-deploy (sourced
# by bash): plain KEY=value lines, no quotes, no spaces.

PHX_SERVER=true
# The public host name, e.g. catalog.example.org (required: the app does not
# start without it); Google's redirect URI is https://<PHX_HOST>/auth/google/callback
PHX_HOST=
PORT=4994
# NOTE(Claude Opus 5.5 2026-11-18): Caddy runs on another VM
# and proxies to this one's internal address, port PORT: listen on every
# address of the VM (127.0.0.1 and the internal IP; the external IP is not on
# the VM). The GCP firewall must let only Caddy's VM reach PORT. Without it,
# the app listens on 127.0.0.1 only (for a Caddy on the same VM).
LISTEN_IP=0.0.0.0
DATABASE_PATH=/srv/fgdc/data/fg_data_catalog.db
SECRET_KEY_BASE=
# The production OAuth client (Google Cloud console, APIs & Services, Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

LANG=C.UTF-8
RELEASE_TMP=/srv/fgdc/tmp
ERL_CRASH_DUMP=/srv/fgdc/tmp/erl_crash.dump
