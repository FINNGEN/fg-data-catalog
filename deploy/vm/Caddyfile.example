# NOTE(Claude Opus 5.5 2026-11-18): the catalog's site block, to add to the
# VM's Caddyfile (with the real PHX_HOST), then `sudo systemctl reload caddy`.
# Caddy gets the certificate, sets X-Forwarded-Proto and proxies the
# LiveView websockets as they are.
catalog.example.org {
	reverse_proxy 127.0.0.1:4994

	handle_errors 502 503 504 {
		header Content-Type "text/html; charset=utf-8"
		header Cache-Control "no-store"
		header Retry-After "30"
		respond <<HTML
			<!DOCTYPE html>
			<html lang="en">
			<head>
			<meta charset="utf-8">
			<meta name="viewport" content="width=device-width, initial-scale=1">
			<title>Back in a minute · FinnGen Data Catalog</title>
			<style>
			:root { color-scheme: light dark; }
			body {
				margin: 0;
				padding: 2rem 1rem;
				font-family: "Ubuntu Sans", system-ui, sans-serif;
				line-height: 1.4;
				color: light-dark(#1f1f24, #e8e8ec);
				background: light-dark(#f7f7f9, #18181b);
			}
			main { max-width: 36rem; }
			h1 { font-size: 1.5rem; margin: 0 0 1rem; }
			a { color: inherit; }
			</style>
			</head>
			<body>
			<main>
			<h1>Back in a minute</h1>
			<p>The FinnGen Data Catalog is restarting, probably for an update. Please <a href="">reload the page</a> in a minute.</p>
			<p>If it is still down after a few minutes, tell Vincent or ask on the FinnGen Slack.</p>
			</main>
			</body>
			</html>
			HTML {err.status_code}
	}
}
